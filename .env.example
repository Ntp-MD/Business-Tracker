# Supabase — server only. Never expose the service role key to the browser.
SUPABASE_URL=https://ajjjaqjlxutuqigthisy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# owner uuid from Authentication → Users
SUPABASE_USER_ID=
# 1 (default) = Supabase errors stop the request; 0 = fall back to data/*.json
SUPABASE_STRICT=1
ALLOW_ORIGIN=

# Next.js (apps/web) — for local dev copy these into apps/web/.env.local.
# Required for prod auth and live reads. Anon/publishable only; the service role key
# never reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web variant: mockup | prod | live (default prod)
APP_VARIANT=prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Live deployment only: use anon key + public read views instead of service role.
# Apply 20261112000000_live_read_views.sql first.
LIVE_READ_ANON=0

# Optional demo link shown on the prod login page (defaults to this URL).
NEXT_PUBLIC_MOCKUP_URL=https://trendrail-mockup.vercel.app

# Invite-only team access (server only, off by default). Keep public signup disabled
# in Supabase; add invited emails to INVITED_EMAILS, comma-separated.
ALLOW_INVITED_USERS=0
INVITED_EMAILS=

# Worker (apps/worker) — service role stays here.
WORKER_POLL_MS=2000
# Lease and retry for jobs that outlive the worker process.
WORKER_LEASE_MS=3600000
WORKER_MAX_ATTEMPTS=3
# Enabled keyword connectors for Collect (comma-separated registry ids).
# The Settings Collect button uses this list; collections are manual-only.
COLLECT_CONNECTORS=gnews_search

# Local collector API the worker drives (python backend/server.py)
LOCAL_API=http://127.0.0.1:8000

# Collector writes. Keep 0 for dry-run; 1 requires the collector migrations.
COLLECTOR_WRITE_ENABLED=0
