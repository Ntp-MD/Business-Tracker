# Supabase — server only. Never expose the service role key to the browser.
SUPABASE_URL=https://ajjjaqjlxutuqigthisy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# owner uuid from Authentication → Users
SUPABASE_USER_ID=
# 1 (default) = Supabase errors stop the request; 0 = fall back to data/*.json
SUPABASE_STRICT=1
ALLOW_ORIGIN=

# Next.js (apps/web) — anon key only; service role never reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker (apps/worker) — service role stays here.
WORKER_SUPABASE_SERVICE_ROLE_KEY=
WORKER_POLL_MS=2000
