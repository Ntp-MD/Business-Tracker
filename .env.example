# Supabase — server only. Never expose the service role key to the browser.
SUPABASE_URL=https://ajjjaqjlxutuqigthisy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# owner uuid from Authentication → Users
SUPABASE_USER_ID=
# 1 (default) = Supabase errors stop the request; 0 = fall back to data/*.json
SUPABASE_STRICT=1
ALLOW_ORIGIN=

# Next.js (apps/web) — for local dev copy these into apps/web/.env.local.
# Required for prod auth and live reads. Anon/publishable only; the service role key
# never reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web variant: mockup | prod | live (default prod)
APP_VARIANT=prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Live deployment only: use anon key + public read views instead of service role.
# Apply 20261112000000_live_read_views.sql first.
LIVE_READ_ANON=0

# Worker (apps/worker) — service role stays here.
WORKER_POLL_MS=2000

# Local collector API the worker drives (python backend/server.py)
LOCAL_API=http://127.0.0.1:8000

# Collector writes (future adapters). Keep 0 unless intentionally enabling.
COLLECTOR_WRITE_ENABLED=0
